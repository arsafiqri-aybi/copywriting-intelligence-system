{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contradiction.schema.json",
  "title": "Contradiction or Null-Evidence Record",
  "type": "object",
  "required": [
    "id",
    "target_ids",
    "record_type",
    "claim_ids",
    "status",
    "interpretation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "target_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "record_type": {
      "enum": [
        "direct_contradiction",
        "mixed_evidence",
        "null_evidence",
        "construct_mismatch",
        "measurement_mismatch",
        "transport_mismatch"
      ]
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation": {
      "type": "string"
    },
    "moderator_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution_status": {
      "enum": [
        "open",
        "bounded",
        "resolved",
        "irreducible"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "under_review",
        "accepted",
        "superseded"
      ]
    }
  },
  "additionalProperties": true
}