{
  "version": "1.0.0",
  "rules": [
    {
      "id": "MVM-001",
      "signal_pattern": {
        "dimension": "goal_job",
        "fact_types": [
          "explicit_current_goal",
          "desired_outcome"
        ],
        "qualifiers": [
          "currently pursued or repeatedly reported"
        ]
      },
      "target_node_ids": [
        "C2-N01-02"
      ],
      "mapping_kind": "semantic_bridge",
      "activation_effect": "candidate_activate",
      "status": "accepted",
      "rationale": "A stated currently pursued outcome is evidence for considering an active goal representation, but wording alone does not prove goal strength.",
      "scientific_edge_ids": [],
      "claim_ids": [],
      "minimum_evidence": [
        "verbatim interview/sales/support evidence or explicit user brief",
        "goal must be current, not merely aspirational"
      ],
      "non_implications": [
        "does not prove goal commitment",
        "does not prove high importance"
      ],
      "alternative_explanations": [
        "social desirability",
        "hypothetical preference"
      ],
      "runtime_weight": null,
      "weight_semantics": null
    },
