{
  "version": "1.0.0",
  "templates": [
    {
      "id": "EXP-T01",
      "name": "Claim + diagnostic proof",
      "decision_question": "Does adding claim-specific diagnostic proof improve the target behavior relative to the same claim without proof?",
      "design": "randomized_ab",
      "unit": "eligible visitor",
      "intervention": {
        "changes": [
          "diagnostic proof block"
        ],
        "held_constant": [
          "claim",
          "offer",
          "CTA",
          "layout as feasible"
        ]
      },
      "comparison": {
        "description": "same message without diagnostic proof block"
      },
      "primary_outcome": "target behavior/conversion",
      "secondary_outcomes": [
        "time on proof area as descriptive only",
        "support questions",
        "refund/complaint if relevant"
      ],
      "mechanism_target_ids": [
        "C5-N04-03"
      ],
      "identification_level_target": "L1-L2",
      "alternative_explanations": [
        "proof may alter source trust",
        "layout salience"
      ],
      "update_scope": "message_hypothesis"
    },
    {
